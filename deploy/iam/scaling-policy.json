{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTheQueueInventory",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeLaunchTemplateVersions",
        "ec2:DescribeSpotPriceHistory"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadInstanceConsoleOutput",
      "Effect": "Allow",
      "Action": "ec2:GetConsoleOutput",
      "Resource": "arn:aws:ec2:eu-central-1:123456789012:instance/*"
    },
    {
      "Sid": "LaunchOnlyTheApprovedTemplate",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:eu-central-1:123456789012:launch-template/lt-0123456789abcdef0",
        "arn:aws:ec2:eu-central-1::image/ami-*",
        "arn:aws:ec2:eu-central-1:123456789012:subnet/subnet-0123456789abcdef0",
        "arn:aws:ec2:eu-central-1:123456789012:security-group/sg-0123456789abcdef0",
        "arn:aws:ec2:eu-central-1:123456789012:instance/*",
        "arn:aws:ec2:eu-central-1:123456789012:volume/*",
        "arn:aws:ec2:eu-central-1:123456789012:network-interface/*"
      ],
      "Condition": {
        "ArnEquals": {
          "ec2:LaunchTemplate": "arn:aws:ec2:eu-central-1:123456789012:launch-template/lt-0123456789abcdef0"
        }
      }
    },
    {
      "Sid": "TagOnlyWhatThisLaunchCreated",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:eu-central-1:123456789012:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "RunInstances"
        }
      }
    },
    {
      "Sid": "TerminateOnlyOwnedInstances",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:eu-central-1:123456789012:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/ci-burst:managed": "true",
          "ec2:ResourceTag/ci-burst:deployment": "example-ci-burst"
        }
      }
    },
    {
      "Sid": "PassOnlyTheWorkerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::123456789012:role/forgejo-runner",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    }
  ]
}
