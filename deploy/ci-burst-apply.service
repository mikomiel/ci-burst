# One bounded apply per invocation. The image is a one-shot CLI, not a daemon:
# the process exits with the controller's exit code (0 completed decision,
# 2 refusal, 1 provider or cleanup failure), and the timer decides when the next
# run starts.
#
# The service stays activating while the container runs, so `systemctl stop`
# cancels the start job and does not run ExecStop. Cleanup uses a stable
# container name and ExecStopPost, which systemd runs after a stop and after a
# failed start, including a TimeoutStartSec expiry:
#   * --init gives the container a minimal init, so SIGTERM can end the run;
#     the CLI has no signal handler and would be container PID 1 without it;
#   * KillMode=process stops the launcher without killing conmon first, so the
#     cleanup command can still remove the container;
#   * ExecStopPost force-removes the named container and is idempotent.
# Forced removal is the guarantee; the signal path only makes it quick.
#
# The state DIRECTORY is the only writable host path: the SQLite ledger, its
# .lock and its rollback journal must stay together in one directory. Do not
# point this unit at a copied ledger file.
#
# The Forgejo token comes from an env-file, which is visible in
# `podman inspect`; a token-file option is a follow-up, not part of this unit.
# The deployment TOML and the cloud credentials are mounted read-only.
[Unit]
Description=ci-burst apply (one bounded AWS Spot capacity decision)
Documentation=https://github.com/mikomiel/ci-burst/blob/main/docs/container.md
Wants=network-online.target
After=network-online.target

#
# The unit names the `ci-burst` podman network instead of the default bridge.
# The bridge MTU must not exceed the host's path MTU: a larger one makes large
# TLS responses stall with no error, and the controller's provider and Forgejo
# calls are exactly that traffic. Create the network with the host's path MTU
# before enabling the unit; docs/container.md has the command and the reason.
[Service]
Type=oneshot
TimeoutStartSec=300
TimeoutStopSec=15
KillMode=process
ExecStart=/usr/bin/podman run --rm --replace --init --network ci-burst --name ci-burst-apply \
    --read-only \
    --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m \
    --volume /etc/ci-burst/deployment.toml:/etc/ci-burst/deployment.toml:ro \
    --volume /var/lib/ci-burst:/var/lib/ci-burst:rw \
    --volume /etc/ci-burst/aws-scaling:/etc/ci-burst/aws:ro \
    --env-file /etc/ci-burst/forgejo.env \
    localhost/ci-burst:latest apply --config /etc/ci-burst/deployment.toml
ExecStopPost=-/usr/bin/podman rm --force --ignore --time 5 ci-burst-apply
