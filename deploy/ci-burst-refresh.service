# Build the current ci-burst main as the controller image and promote it.
#
# This unit deploys the controller, not a release: no image is published to a
# registry, no tag is created and nothing is announced. It exists so a merged
# change reaches the host that runs the controller without a human remembering
# to rebuild.
#
# A failed run leaves the previous image in place and is visible in the journal
# with a reason code. The next scheduled run is the retry: there is no backoff
# and no build retry inside a run, because a build that failed once for a network
# reason is not evidence about the next attempt. The one exception is the smoke
# `plan` run, which retries once after a few seconds (see the script) because an
# unreachable Forgejo or AWS is not evidence about the image either.
[Unit]
Description=Build the current ci-burst main as the controller image
Documentation=https://github.com/mikomiel/ci-burst/blob/main/docs/container.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=900
Nice=10
ExecStart=/usr/local/sbin/ci-burst-refresh
ExecStopPost=/usr/local/sbin/ci-burst-state
# Logical, public-safe deployment target and the controller's unit list. The
# cleanup drop-in overrides both for the reaper host.
Environment=CI_BURST_TARGET=controller
Environment="CI_BURST_UNITS=ci-burst-apply.service ci-burst-apply.timer ci-burst-refresh.service ci-burst-refresh.timer ci-burst-export.service ci-burst-export.timer"
