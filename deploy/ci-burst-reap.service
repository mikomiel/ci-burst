# Expiry cleanup runs as its own unit, timer and credential mount.
#
# Cleanup must not share the scaler's failure domain (docs/operations.md owns
# that rule). A failing, hung or misconfigured apply timer must not stop expiry
# termination, and this unit must keep working while the scaler is disabled.
# Install it where the scaler's process and host failure cannot stop it.
#
# It deliberately receives no Forgejo token, no env-file and no state mount:
# `reap --apply` needs neither Forgejo nor the scaling ledger. It describes
# owned instances and terminates only expired ones with the cleanup identity.
[Unit]
Description=ci-burst reap (expiry cleanup of owned AWS Spot instances)
Documentation=https://github.com/mikomiel/ci-burst/blob/main/docs/container.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=300
ExecStart=/usr/bin/podman run --rm \
    --read-only \
    --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m \
    --volume /etc/ci-burst/deployment.toml:/etc/ci-burst/deployment.toml:ro \
    --volume /etc/ci-burst/aws-cleanup:/etc/ci-burst/aws:ro \
    localhost/ci-burst:latest reap --apply --config /etc/ci-burst/deployment.toml
