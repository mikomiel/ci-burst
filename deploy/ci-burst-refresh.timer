# Image refresh schedule. The next run is scheduled from when the previous one
# finished, so two refreshes never overlap; the script's own lock is the second
# line of defence, not the scheduler.
[Unit]
Description=Refresh the ci-burst controller image from origin/main

[Timer]
OnBootSec=2min
OnUnitInactiveSec=5min
AccuracySec=30s
Unit=ci-burst-refresh.service

[Install]
WantedBy=timers.target
